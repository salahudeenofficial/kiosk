# Kiosk Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# Backend API URL - Set this to your backend server address
# Example: http://localhost:8000 or https://api.yourbackend.com
VITE_API_BASE_URL=

# Optional: Pre-configured kiosk credentials (if set, will be used in config screen)
# These can also be entered manually in the config screen
VITE_KIOSK_ID=
VITE_KIOSK_PASSWORD=

